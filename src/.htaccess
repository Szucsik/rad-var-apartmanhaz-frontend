# Apache / LiteSpeed rules for the FTP hosts (Azure Static Web Apps uses staticwebapp.config.json).
# Every language has its own URL (/hu, /pl, /en, /de) that is served by the single-page app.
Options -MultiViews
RewriteEngine On

# Canonical host on production: https://rad-var-apartmanhaz.hu (no www). Other hosts (dev/staging) are left alone.
RewriteCond %{HTTP_HOST} ^(www\.)?rad-var-apartmanhaz\.hu$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://rad-var-apartmanhaz.hu%{REQUEST_URI} [R=301,L]

# /en/ -> /en
RewriteRule ^(hu|pl|en|de)/$ /$1 [R=301,L]

# Language URLs -> the app
RewriteRule ^(hu|pl|en|de)$ index.html [L]

AddType text/yaml .yaml
AddType application/xml .xml

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/yaml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
